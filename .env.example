# Environment Configuration — GRag (hhgoa_task_2)
# Copy this file to .env.local and fill in your actual values.
# DO NOT commit .env.local to git.

# ─── AI Services ───────────────────────────────────────────────────────────────

# Sarvam AI — Speech-to-Text (Saaras v3)
# Get your key at: https://sarvam.ai
SARVAM_API_KEY="sk_your_sarvam_key_here"

# ElevenLabs — Optional fallback STT
# Get your key at: https://elevenlabs.io
ELEVENLABS_API_KEY=""

# OpenRouter — LLM Inference & Embeddings (NVIDIA Nemotron)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key_here"

# ─── MongoDB Atlas ──────────────────────────────────────────────────────────────

# Full connection string from MongoDB Atlas dashboard
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/...
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=GRag"

# MongoDB Data API (optional, not required for vector search)
MONGODB_DATA_API_URL=""
MONGODB_DATA_API_KEY=""

# Database & collection config (defaults shown below)
MONGODB_DATA_SOURCE="Cluster0"
MONGODB_DATABASE="ai_demo"
MONGODB_COLLECTION="chunks"
